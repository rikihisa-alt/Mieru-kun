# Supabase 接続 (フロント公開可能キーのみ。secret / service_role は絶対に置かない)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# 認証ゲートを有効化するフラグ (既定OFF)。
# Supabase接続と認証強制は分離しており、認証フェーズで true を設定して初めて
# 未ログイン→/login のリダイレクトが働く。基盤導入段階では設定しない。
# NEXT_PUBLIC_AUTH_ENFORCED=true
